{
  "plugins": ["@ianvs/prettier-plugin-sort-imports", "prettier-plugin-jsdoc"],
  "singleQuote": true,
  "jsxSingleQuote": true,
  "arrowParens": "always",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "es5",
  "jsdocDescriptionWithDot": true,
  "jsdocVerticalAlignment": true,
  "jsdocSeparateReturnsFromParam": true,
  "jsdocPreferCodeFences": true,
  "tsdoc": true,
  "importOrder": [
    "^react",
    "^@skbkontur/(.*)",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^utils/(.*)$",
    "^settings/(.*)$",
    "^context(.*)$",
    "",
    "^pages(.*)$",
    "",
    "^shared(.*)$",
    "^components/(?!.*\\.module\\.css$)(.*)$",
    "",
    "^features/(.*)$",
    "",
    "^[./](?!.*\\.module\\.css$)",
    "",
    ".*\\.module\\.css$"
  ],
  "importOrderCaseSensitive": true,
  "importOrderParserPlugins": ["classProperties", "typescript", "jsx"]
}
